{
  "name": "context-window",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Canonical SaaS skill library for Claude Code, Codex and Cursor, with a safe installer, catalog gates, an architecture gate and a web + mobile product template.",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "cw": "node scripts/cw.mjs",
    "catalog": "node scripts/cw.mjs catalog --check",
    "catalog:lock": "node scripts/cw.mjs catalog --write-lock",
    "test": "node --test \"test/*.test.mjs\"",
    "secrets": "node scripts/secret-scan.mjs",
    "lint:md": "markdownlint-cli2 --no-globs \"**/*.md\" \"#imported-skills/**\" \"#acceptance/evidence/**\"",
    "lint:md:imported": "markdownlint-cli2 --no-globs \"imported-skills/**/*.md\"",
    "fix:md": "node scripts/fix-markdownlint.mjs --write",
    "format": "prettier --write scripts test catalog",
    "format:check": "prettier --check scripts test catalog",
    "evals:init": "node scripts/init-skill-replay.mjs",
    "evals:score": "node scripts/score-skill-replays.mjs",
    "qa": "pnpm catalog && pnpm test && pnpm lint:md && pnpm secrets && pnpm format:check",
    "acceptance": "node scripts/acceptance.mjs"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.22.0",
    "prettier": "^3.8.2",
    "typescript": "5.9.3"
  }
}
