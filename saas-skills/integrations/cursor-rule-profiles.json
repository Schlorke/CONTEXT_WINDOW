{
  "version": "1.1.0",
  "$comment": "Per-skill runtime profiles. `globs` drive Cursor auto-attach. `claudePaths` drive the Claude `paths:` frontmatter (file-scoped visibility); an explicit empty array opts a skill OUT of the globs fallback so it stays always-on via description (use for broad skills or globs with brace patterns, which Claude paths may not expand). `promptTriggers` feed the optional Claude skill-router hook; keep them SPECIFIC (multiword or domain terms) to avoid noisy suggestions, and write them unaccented (the router strips diacritics on both sides).",
  "rules": [
    {
      "skill": "design-system-implementation",
      "file": "skill-design-system-implementation.mdc",
      "description": "Design system guidance for semantic tokens, Storybook, component governance, and shared UI contracts in frontend codebases.",
      "promptTriggers": [
        "design system",
        "design token",
        "storybook",
        "component library",
        "biblioteca de componentes",
        "atomic design"
      ]
    },
    {
      "skill": "react-saas-architecture",
      "file": "skill-react-saas-architecture.mdc",
      "description": "React and Next.js App Router architecture for feature boundaries, shared layers, co-location, and export discipline.",
      "globs": [
        "**/*.{ts,tsx,js,jsx}",
        "app/**/*.{ts,tsx,js,jsx}",
        "src/**/*.{ts,tsx,js,jsx}",
        "components/**/*.{ts,tsx,js,jsx}"
      ],
      "claudePaths": [],
      "promptTriggers": [
        "estrutura de pastas",
        "folder structure",
        "app router",
        "barrel export",
        "organizacao de codigo",
        "feature-based"
      ]
    },
    {
      "skill": "saas-ui-specifications",
      "file": "skill-saas-ui-specifications.mdc",
      "description": "Frontend UI specification guidance for typography, color roles, spacing, density, responsive behavior, and accessibility.",
      "globs": [
        "**/*.{tsx,jsx,css,scss,mdx}",
        "app/**/*.{tsx,jsx,css,scss,mdx}",
        "src/**/*.{tsx,jsx,css,scss,mdx}",
        "components/**/*.{tsx,jsx,css,scss,mdx}"
      ],
      "claudePaths": [],
      "promptTriggers": [
        "tipografia",
        "typography scale",
        "paleta de cores",
        "color palette",
        "espacamento",
        "dark mode",
        "acessibilidade",
        "wcag",
        "responsivo"
      ]
    },
    {
      "skill": "component-reuse-portability",
      "file": "skill-component-reuse-portability.mdc",
      "description": "Cross-project component porting workflow for dependency resolution, import rewriting, token adaptation, and registry maintenance.",
      "promptTriggers": [
        "portar componente",
        "port component",
        "reaproveitar componente",
        "reuse component",
        "component registry",
        "entre projetos"
      ]
    },
    {
      "skill": "clean-architecture-ddd",
      "file": "skill-clean-architecture-ddd.mdc",
      "description": "Domain-driven and clean architecture guidance for bounded contexts, use cases, entities, repositories, and layer separation.",
      "promptTriggers": [
        "clean architecture",
        "bounded context",
        "domain-driven",
        "\\bddd\\b",
        "value object",
        "camada de dominio",
        "caso de uso"
      ]
    },
    {
      "skill": "api-design-patterns",
      "file": "skill-api-design-patterns.mdc",
      "description": "REST and route-handler guidance for auth, validation, error envelopes, pagination, rate limiting, webhooks, and tenant isolation.",
      "globs": [
        "**/api/**/*.{ts,tsx,js,jsx}",
        "**/route.{ts,tsx,js,jsx}",
        "app/api/**/*.{ts,tsx,js,jsx}",
        "src/app/api/**/*.{ts,tsx,js,jsx}",
        "pages/api/**/*.{ts,tsx,js,jsx}"
      ],
      "claudePaths": [
        "**/api/**",
        "**/route.ts",
        "**/route.tsx",
        "app/api/**",
        "src/app/api/**",
        "pages/api/**"
      ],
      "promptTriggers": [
        "rota de api",
        "route handler",
        "rest api",
        "endpoint",
        "webhook",
        "paginacao",
        "rate limit"
      ]
    },
    {
      "skill": "prisma-database-design",
